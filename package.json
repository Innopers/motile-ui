{
  "name": "motile-ui",
  "version": "0.9.0",
  "type": "module",
  "description": "A modern React component library for webview applications",
  "main": "./dist/motile-ui.umd.js",
  "module": "./dist/motile-ui.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/motile-ui.es.js",
      "require": "./dist/motile-ui.umd.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-interactions": "^8.4.7",
    "@storybook/addon-links": "^8.4.7",
    "@storybook/blocks": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@storybook/test": "^8.4.7",
    "@types/node": "^24.9.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.4.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-dts": "^4.3.0"
  },
  "keywords": [
    "react",
    "react-component",
    "component-library",
    "ui-library",
    "webview",
    "mobile",
    "typescript",
    "vite",
    "accessible",
    "ui",
    "design-system",
    "button",
    "input",
    "modal",
    "drawer"
  ],
  "author": "jtnoh300@gmail.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Innopers/motile-ui.git"
  },
  "homepage": "https://github.com/Innopers/motile-ui#readme",
  "bugs": {
    "url": "https://github.com/Innopers/motile-ui/issues"
  },
  "license": "MIT",
  "sideEffects": false
