{
  "name": "motile-ui",
  "version": "1.1.0",
  "type": "module",
  "description": "A modern React component library for webview applications",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Accordion": {
      "types": "./dist/components/Accordion/Accordion.d.ts",
      "import": "./dist/components/Accordion/Accordion.js"
    },
    "./Badge": {
      "types": "./dist/components/Badge/Badge.d.ts",
      "import": "./dist/components/Badge/Badge.js"
    },
    "./Button": {
      "types": "./dist/components/Button/Button.d.ts",
      "import": "./dist/components/Button/Button.js"
    },
    "./Checkbox": {
      "types": "./dist/components/Checkbox/Checkbox.d.ts",
      "import": "./dist/components/Checkbox/Checkbox.js"
    },
    "./Dock": {
      "types": "./dist/components/Dock/Dock.d.ts",
      "import": "./dist/components/Dock/Dock.js"
    },
    "./Drawer": {
      "types": "./dist/components/Drawer/Drawer.d.ts",
      "import": "./dist/components/Drawer/Drawer.js"
    },
    "./Input": {
      "types": "./dist/components/Input/Input.d.ts",
      "import": "./dist/components/Input/Input.js"
    },
    "./Modal": {
      "types": "./dist/components/Modal/Modal.d.ts",
      "import": "./dist/components/Modal/Modal.js"
    },
    "./Popover": {
      "types": "./dist/components/Popover/Popover.d.ts",
      "import": "./dist/components/Popover/Popover.js"
    },
    "./Sheet": {
      "types": "./dist/components/Sheet/useSheetNavigation.d.ts",
      "import": "./dist/components/Sheet/useSheetNavigation.js"
    },
    "./Skeleton": {
      "types": "./dist/components/Skeleton/Skeleton.d.ts",
      "import": "./dist/components/Skeleton/Skeleton.js"
    },
    "./SpeedDial": {
      "types": "./dist/components/SpeedDial/SpeedDial.d.ts",
      "import": "./dist/components/SpeedDial/SpeedDial.js"
    },
    "./Switch": {
      "types": "./dist/components/Switch/Switch.d.ts",
      "import": "./dist/components/Switch/Switch.js"
    },
    "./Textarea": {
      "types": "./dist/components/Textarea/Textarea.d.ts",
      "import": "./dist/components/Textarea/Textarea.js"
    },
    "./Toast": {
      "types": "./dist/components/Toast/Toast.d.ts",
      "import": "./dist/components/Toast/Toast.js"
    },
    "./ToastProvider": {
      "types": "./dist/components/Toast/Toast.d.ts",
      "import": "./dist/components/Toast/Toast.js"
    },
    "./Tooltip": {
      "types": "./dist/components/Tooltip/Tooltip.d.ts",
      "import": "./dist/components/Tooltip/Tooltip.js"
    },
    "./useToast": {
      "types": "./dist/components/Toast/useToast.d.ts",
      "import": "./dist/components/Toast/useToast.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-interactions": "^8.4.7",
    "@storybook/addon-links": "^8.4.7",
    "@storybook/blocks": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@storybook/test": "^8.4.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.9.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "chromatic": "^13.3.3",
    "happy-dom": "^20.0.10",
    "jsdom": "^27.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.4.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "react",
    "react-component",
    "component-library",
    "ui-library",
    "webview",
    "mobile",
    "typescript",
    "vite",
    "accessible",
    "ui",
    "design-system",
    "button",
    "input",
    "modal",
    "drawer"
  ],
  "author": "jtnoh300@gmail.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Innopers/motile-ui.git"
  },
  "homepage": "https://www.motile-ui.site",
  "bugs": {
    "url": "https://github.com/Innopers/motile-ui/issues"
  },
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ]
}
